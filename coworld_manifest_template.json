{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/coworld/main/src/coworld/coworld_manifest_schema.json",
  "tags": ["strategy", "team-based", "survival"],
  "game": {
    "name": "tribal_village",
    "description": "A 2-8 team Tribal Village Coworld with six agents per village. One entrant policy controls all six teammates while they gather, craft, fight tumors, and defend their territory.",
    "owner": "info@metta.ai",
    "runnable": {
      "type": "game",
      "image": "{{TRIBAL_VILLAGE_IMAGE}}",
      "run": [
        "python",
        "-m",
        "tribal_village_env.coworld.server"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-tribal-village/tree/main"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players",
        "team_count",
        "num_agents",
        "max_steps",
        "tick_rate"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per active Tribal Village agent slot; exactly six slots per configured team.",
          "type": "array",
          "minItems": 12,
          "maxItems": 48,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "description": "One player display-name object per active agent slot; exactly six slots per configured team.",
          "type": "array",
          "minItems": 12,
          "maxItems": 48,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "max_steps": {
          "description": "Maximum simulation steps before truncation.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "tick_rate": {
          "description": "Simulation steps per second.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "player_connect_timeout_seconds": {
          "description": "Seconds to wait for players before starting with no-op actions for missing slots.",
          "type": "number",
          "minimum": 0,
          "default": 180
        },
        "seed": {
          "description": "Optional deterministic episode seed used for map generation, replay, and bundled scripted AI mirrors. Omit or set 0 to choose a fresh random episode seed.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "team_count": {
          "description": "Active village teams. Each team receives one village, six player slots, and one hostile spawner.",
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "num_agents": {
          "description": "Active player slots; must equal team_count multiplied by six. Used by the tournament commissioner for team seating.",
          "type": "integer",
          "minimum": 12,
          "maximum": 48,
          "multipleOf": 6
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scores",
        "team_scores",
        "ticks",
        "truncation_reason"
      ],
      "properties": {
        "scores": {
          "description": "One cumulative reward score per active agent slot.",
          "type": "array",
          "minItems": 12,
          "maxItems": 48,
          "items": {
            "type": "number"
          }
        },
        "team_scores": {
          "description": "One team score per active village, each summing its six agent scores.",
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "number"
          }
        },
        "ticks": {
          "type": "integer",
          "minimum": 0
        },
        "truncation_reason": {
          "type": "string"
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-tribal-village/blob/6683204b649732bf9bded795d3634ff1552602c3/tribal_village_env/coworld/docs/player_protocol_spec.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-tribal-village/blob/6683204b649732bf9bded795d3634ff1552602c3/tribal_village_env/coworld/docs/global_protocol_spec.md"
      },
      "engine_runtime": "nimgrid"
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-tribal-village/blob/6683204b649732bf9bded795d3634ff1552602c3/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "rules.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-tribal-village/blob/6683204b649732bf9bded795d3634ff1552602c3/docs/rules.md"
          }
        },
        {
          "id": "play_tribal_village.md",
          "title": "play_tribal_village.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-tribal-village/blob/6683204b649732bf9bded795d3634ff1552602c3/docs/play_tribal_village.md"
          }
        }
      ]
    }
  },
  "player": [
    {
      "id": "villager",
      "name": "Villager Scripted AI",
      "type": "player",
      "image": "{{TRIBAL_VILLAGE_PLAYER_IMAGE}}",
      "run": [
        "/bin/villager"
      ],
      "source_url": "https://github.com/Metta-AI/coworld-tribal-village/tree/main/players/villager",
      "description": "Bundled native Nim player that mirrors the episode deterministically and replays the built-in role-based scripted AI through the Coworld player WebSocket."
    }
  ],
  "reporter": [],
  "commissioner": [
    {
      "id": "default-commissioner",
      "name": "Tribal Village Team Commissioner",
      "type": "commissioner",
      "description": "Seats one distinct entrant policy in each village and gives it all six teammates.",
